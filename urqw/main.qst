end

:Udld9
pln Вы делаете удар...
pause 2000
if ToHit>=AcNPC9 then pln Вы поподаете по противнику.
if ToHit>=AcNPC9 then HPNPC9=HPNPC9-Uron
if ToHit<AcNPC9 then pln Вы не попадаете по противнику.
pln Противник делает удар...
pause 2000
if ToHitNPC9>=Ac then pln Противник попадает в вас.
if ToHitNPC9>=Ac then HP=HP-UronNPC9
if ToHitNPC9<Ac then pln Противник не попадает в вас.
pause 2000
hg=RND
if hg>=0.7 then pln Олайдец умудряется слегка пырнуть вас ножиком. & HP=HP-3  
if hg>=0.4 and hg<0.7 then pln Олайдец пытается пырнуть вас ножиком, но промахивается.
if hg>=0.1 and hg<0.4 then pln Олайдец пытается обойти вас сзади и ударить ножом в спину, но вы уворачиваетесь.
if hg>=0 and hg<0.1 then pln Олайдец пытается обойти вас сзади и ударить ножом в спину, ему это удается. & HP=HP-9
pause 2000
Goto DDD9
end

