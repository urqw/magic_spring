ToHit=RND*10+4
Uron=RND*10+exp-2
AC=3+Shield+Nar
ToHitNPC1=RnD*10
UronNPC1=RND*10+6
AcNPC1=5
if HP>20 then pln Вы чувствуете себя нормально.
if HP<20 and HP>=10 then pln Вы чувствуете себя средне, у вас кровоточат раны.
if HP<10 and HP>0 then pln Вы чувствуете себя ужасно, вы близки к смерти.
if HP<0 and HPNPC1>0 then pln Вы мертвы.
if HPNPC1>=25 then pln Противник выглядит нормально.
if HPNPC1<25 and HPNPC1>=13 then pln Противник изранен.
if HPNPC1<13 and HPNPC1>=0 then pln Противник сильно изранен, он близок к смерти.
if HPNPC1<0 then pln Противник мертв.
if HP>=0 and HPNPC1>=0 then btn Udlo, Ударить
if HP>=0 and амулет then btn Healmeo, Исцелиться амулетом
if HP<0 and HPNPC1>=0 then btn Smert, Смерть
if HPNPC1<0 then btn Poo, Победа
end

