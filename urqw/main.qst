if HP>=0 and амулет then btn Healmem, Исцелиться амулетом
if HP>=0 and HPNPC1>=0 then btn Udlm, Ударить
if HP<0 and HPNPC1>=0 then btn Smert, Смерть
if HPNPC1<0 and HP>=0 then btn Poo, Победа
end

:Healmeg
inv- амулет
pln Вы подносите амулет к сердцу и чувствуете, как силы возвращаются к вам.
if HP<25 then HP=HP+10
if HP>=25 then HP=20+karma+(exp*2)
goto GGG1
end

