if ToHit>=AcNPC1 then pln Вы поподаете по противнику.
if ToHit>=AcNPC1 then HPNPC1=HPNPC1-Uron
if ToHit<AcNPC1 then pln Вы не попадаете по противнику.
pln Противник делает удар...
pause 2000
if ToHitNPC1>=Ac then pln Противник попадает в вас.
if ToHitNPC1>=Ac then HP=HP-UronNPC1
if ToHitNPC1<Ac then pln Противник не попадает в вас.
pause 2000
Goto KKK1
end



:DeadLord
bile=0
pln Вы входите в покои Лорда.
pln Это большая комната, стены которой увешаны огромными красивыми коврами вокруг расставлена красивая мебель.
pln В центре стоит лорд Брайдз с длинным клинком наготове. Его мудрый взгляд словно пропитан злобой.
pln "Глупец, ты сам сделал себе приговор. Через минуту здесь будет тридцать гвардейцев, они вместе со мной отомстят за смерть Патлэна."
btn Sdt, Сдаться
btn DeadLore, Убить Лорда
end

:Sdt
pln Вы бросаете оружие на пол и умоляете пощадить.
pln "Нет, надо сначала думать, а потом совершать такие поступки. Я сохраню твою никчемную жизнь, но ты будешь навеки гнить в моей темнице."
pln Через пару мгновений в комнату врываются гвардейцы, берут вас под руки и несут в темницу, что находится в подвале одной из башен.
pln Бежать оттуда не возможно, ваш путь закончен.
perkill
end

:DeadLore
bile=0
pln Вы набрасывайтесь на Лорда.
pln "Вспомню дни, когда я был молод!" - Выкрикивает Брайдз.
HPNPC1=39
if дубина then btn DDD2, Биться дубиной
if моргенштерн then btn MMM2, Биться моргенштерном
if оркский меч then btn OOO2, Биться оркским мечом
if гвардейский меч then btn GGG2, Биться гвардейским мечом
if короткий меч then btn KKK2, Биться коротким мечом
btn CCC2, Биться кулаками
end

:CCC2
pln После вашего удара, который ен принес никакого ущерба лорду, ударяет он. Насмерть.
perkill
end

:DDD2
bile=bile+1
if щит then Shield=2
if наручи then Nar=1
ToHit=RND*10
Uron=RND*11+exp+2
AC=3+Shield+Nar
ToHitNPC1=RnD*10+1
UronNPC1=RND*10+9
AcNPC1=6
if HP>20 then pln Вы чувствуете себя нормально.
if HP<20 and HP>=10 then pln Вы чувствуете себя средне, у вас кровоточат раны.
if HP<10 and HP>0 then pln Вы чувствуете себя ужасно, вы близки к смерти.
if HP<0 and HPNPC1>=0 then pln Вы мертвы.
if HPNPC1>=25 then pln Противник выглядит нормально.
if HPNPC1<25 and HPNPC1>=13 then pln Противник изранен.
if HPNPC1<13 and HPNPC1>=0 then pln Противник сильно изранен, он близок к смерти.
if HPNPC1<0 then pln Противник мертв.
if bile>5 then pln Внезапно в комнату врывается дюжина гвардейцев с мечами наготове. Немедля они подбегают с разных сторон и убивают вас.
if not bile>5 and HP>=0 and HPNPC1>=0 then btn Udld1, Ударить
if not bile>5 and HP>=0 and амулет then btn Healmed2, Исцелиться амулетом
if not bile>5 and HP<0 and HPNPC1>=0 then btn Smert1, Смерть
if not bile>5 and HPNPC1<0 then btn Poo1, Победа
end

