if hg>=0.4 and hg<0.7 then pln Орк заносит свою дубину, но промахивается.
if hg>=0.1 and hg<0.4 then pln Орк пытается налететь с дубиной сбоку, но вы удачно парируете удар.
if hg>=0 and hg<0.1 then pln Орк пытается налететь с дубиной сбоку и ему это удается - он наносит сильный удар. & HP=HP-10
pause 2000
Goto BBB8
end





:Band2
pln  Вы решаете атаковать орка.
pln  Тот еще крепче хватается за дубину.
HP=20+karma+(exp*2)
HPNPC9=30
if дубина then btn DDD9, Биться дубиной
if моргенштерн then btn MMM9, Биться моргенштерном
if оркский меч then btn OOO9, Биться оркским мечом
if гвардейский меч then btn GGG9, Биться гвардейским мечом
if короткий меч then btn KKK9, Биться коротким мечом
if клинок Брайдза then btn BBB9, Биться клинком Брайдза
btn CCC9, Биться кулаками
end


:CCC9
pln После вашего удара, который не принес никакого существенного ущерба орку, ударяет он. Насмерть.
perkill
end

:DDD9
if кольчуга Ghia then Gh=2
if щит then Shield=2
if наручи then Nar=1
ToHit=RND*10
Uron=RND*11+exp+2
AC=3+Shield+Nar+Gh
ToHitNPC9=RnD*10-2
UronNPC9=RND*10+4
AcNPC9=4
if HP>20 then pln Вы чувствуете себя нормально.
if HP<20 and HP>=10 then pln Вы чувствуете себя средне, у вас кровоточат раны.
if HP<10 and HP>0 then pln Вы чувствуете себя ужасно, вы близки к смерти.
if HP<0 and HPNPC9>0 then pln Вы мертвы.
if HPNPC9>=25 then pln Противник выглядит нормально.
if HPNPC9<25 and HPNPC9>=13 then pln Противник изранен.
if HPNPC9<13 and HPNPC9>=0 then pln Противник сильно изранен, он близок к смерти.
if HPNPC9<0 then pln Противник мертв.
if HPNPC9>0 and HPNPC9<13 and HP>0 then pln "Клаус, помогай!" - Выкрикивает орк.
if HP>=0 and HPNPC9>=0 then btn Udld9, Ударить
if HP>=0 and амулет then btn Healmed9, Исцелиться амулетом
if HP<0 and HPNPC9>=0 then btn Smert9, Смерть
if HPNPC9<0 then btn Poo9, Победа
end

